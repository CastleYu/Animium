# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
# Local example only. Production may point to a remote or managed PostgreSQL.
DATABASE_URL=postgresql://animium:animium@localhost:5432/animium
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# PostgreSQL TLS
# Allowed policy values should be validated by packages/config.
# Suggested values: disable | require | verify-ca | verify-full
DATABASE_SSL_MODE=disable
# Path to a CA file mounted by the runtime/secret manager. Leave empty when unused.
DATABASE_SSL_CA_PATH=

# Redis / BullMQ
# Supports redis:// and rediss://. Production may point to remote/managed Redis.
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000

# Logical namespaces.
# BullMQ must use its own prefix option; do not map REDIS_QUEUE_PREFIX to ioredis keyPrefix.
REDIS_QUEUE_PREFIX=animium
REDIS_CACHE_PREFIX=animium:cache

# Optional Redis TLS CA file. rediss:// may be sufficient for some providers.
REDIS_TLS_CA_PATH=

# Queue/cache behavior
QUEUE_ENQUEUE_TIMEOUT_MS=5000
CACHE_ENABLED=true

# Public API
PUBLIC_API_RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:3000
API_RESPONSE_CACHE_TTL_SECONDS=60

# Ingestion defaults
HTTP_CONNECT_TIMEOUT_MS=5000
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_MAX_RESPONSE_BYTES=10485760
RAW_SAMPLE_RETENTION_DAYS=7

# Bangumi
# Use a descriptive non-browser UA identifying this project.
BANGUMI_USER_AGENT=Animium/0.1 (+https://github.com/CastleYu/Animium)

# MyAnimeList API v2
MAL_CLIENT_ID=

# AnimeSchedule API v3
ANIMESCHEDULE_TOKEN=

# AniList restricted adapter
# Must remain false until the production legal gate is explicitly approved.
ANILIST_ENABLED=false
ANILIST_CACHE_TTL_SECONDS=300

# Optional / disabled fallback
JIKAN_ENABLED=false

# Source enable policy
# Live probe must still pass before a source is actually enabled.
ENABLE_LIVE_SOURCE_PROBE=true

# Observability
METRICS_ENABLED=true
METRICS_PORT=9090

# Do not add real secrets to this file.
# Copy to .env locally and keep .env out of version control.
